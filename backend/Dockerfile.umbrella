# Build from the fleet root with the verified sibling Base checkout.
FROM rust:1.88.0-slim-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/admin-panel/backend
COPY services-base/Cargo.toml /workspace/services-base/Cargo.toml
COPY services-base/crates /workspace/services-base/crates
COPY services-base/docs/contracts /workspace/services-base/docs/contracts
COPY admin-panel/backend ./
RUN cargo build --locked --release --bin admin-panel-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 wget && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /workspace/admin-panel/backend/target/release/admin-panel-server /usr/local/bin/admin-panel-server
COPY admin-panel/backend/migration/migrations /app/migration/migrations
EXPOSE 7771
ENTRYPOINT ["admin-panel-server"]
