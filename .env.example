# Base Admin Panel — environment template (copy to .env for local runs).
# Never commit real secrets.

# PostgreSQL
ADMINP_POSTGRES_PASSWORD=change-me

# Runtime (server)
ADMINP_BIND_ADDRESS=0.0.0.0
ADMINP_BIND_PORT=7771
ADMINP_DATABASE_URL=postgres://adminpanel:${ADMINP_POSTGRES_PASSWORD}@postgres:5432/adminpanel
ADMINP_MIGRATIONS_DIR=/app/migration/migrations

# CORS: product origins allowed to call admin API
ADMINP_CORS_ALLOWED_ORIGINS=http://localhost:7772,http://localhost:7712,http://localhost:7722,http://localhost:7732,http://localhost:7742

# Central auth (auth-server): JWKS verification for mutations.
# Missing/invalid bearer => 401; valid token without a platform role => 403.
ADMINP_AUTH__CENTRAL_JWKS_URI=http://auth:7701/oidc/jwks
ADMINP_AUTH__CENTRAL_ISSUER=http://127.0.0.1:7701

# Frontend build-time (umbrella Dockerfile)
VITE_PLATFORM_BRANDING_URL=http://localhost:7771/api/v1/runtime/branding
VITE_PLATFORM_SERVICES_URL=http://localhost:7771/api/v1/runtime/services
